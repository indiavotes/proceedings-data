  4362725 \n25  1701153 \n26  345063 \n27  10558209 \n28  559172 \n29  10877644 \n30  22323 \n31  41170 \n32  32819 \n33  15001 \n34  975186 \n35  6884 \n36  44131 \n   91747104 \n***** \n111\n\nभारत सरकार \nमानव संसाधन िवकास मंत्रालय \nउÍचतर िशक्षा िवभाग \n \nराÏय सभा \nअतारांिकत प्रæन संख्याः 667 \nउƣर देने की तारीखः 27.06.2019 \n \nनए के Ûद्रीय िवæविवɮयालयɉ की èथापना \n \n667. Įी धमर्पुरी Įीिनवासः \nĮी टी॰ जी॰ वɅकटेशः \n \nक्या मानव संसाधन िवकास मंत्री यह बतानेकी कृ पा करɅगे िकः \n \n(क) क्या यह सच है िक सरकार देश मɅ 13 नए क ेÛद्रीय िवæविवɮयालयɉ की èथा पना करने \nकीयोजना बना रही है और इनके बुिनयादी ढांचे क ेिलए 3,600 करोड़ ǽपये आवंिटत कर रही है \nऔरयिद हां, तो त×संबंधी Þयौरा क्या है; \n(ख) क्या ऐसे िकसी िवæविवɮयालय कीèथापना आÛध्र प्रदेश और तेलंगाना मɅ की जा रहीहै जैसा \nिक आंध्र प्रदेश पु\nनगर्ठन अिधिनयम, 2014क े अनु\nसार वादा िकया गया था, और\n यिद हां, \nतोत×संबंधी Þयौरा क्या है; और \n(ग) इसके िलये आवंिटत की गई िनिध काÞयौरा क्या है? \nउƣर \nमानव संसाधन िवकास मंत्री  \n(Įी रमेश पोखिरयाल ‘िनशंक’) \n \n(क) से (ग):\n जी, महोदय। वतर्मान मɅ, देश मɅ नया क ेÛद्रीय िवæविवɮयालय è थािपत करने का \nकोई भी प्रèताव नहीं है। हालांिक, आंध्र प्रदेश पुनगर्ठन अिधिनयम, 2014 मɅ आंध्र प्रदेश और \nतेलंगाना राÏयमɅ एक-एक क ेÛद्रीय जनजातीय िवæविवɮयालयऔर आंध्र प्रदेश मɅ एक क ेÛद्री य \nिवæविवɮयालय èथापना की पिरकãपना की गई है। इसके अलावा, प्रधानमंत्री ने 18.08.2015 \nको िबहार क े िलए एक पैक े ज की घोषणा की थी, िजसमɅ िवक्रमिशला िवæविवɮयालय क े \nऐितहािसक èथल पर भागलपु\nर क े पास एक क ेÛद्रीय \n िवæविवɮयालय èथािपत करना शािमल है।  \n112\n\nवतर्मान मɅ आंध्र प्रदेश मɅ प्रè तािवत कɅद्रीय जनजातीय िवæ विवɮयालय एवं कɅद्रीय िवæ विवɮयालय \nè थािपत करने क े पहले चरण का खचर् पूरा करने क े िलए क्रमश: 420 करोड़ और 450 करोड़ \nǾपए की िनिध का प्रावधान है। तेलंगाना राÏ य मɅ प्रè तािवत कɅद्रीय जनजातीय िवæ विवɮयालय \nक े िलए टोकन \nिनिध का प्रावधान िकया गया है।   \n \nपूवर् मɅ, कɅद्रीय मंित्रमंडल ने सीयू\n अिधिनयम, 2009 क े तहत è थािपत 13 नए क ेÛद्रीय \nिवæविवɮयालयɉ क े िलए संशोिधत लागत अनु\nमान ( आर.सी.ई) की मंजूरी दी थी,िजसमɅ वषर् \n2018-19 से 2020-21 तक की अविध क े िलए 3639.32 करोड़ Ǿपये का åयय और आवæ\n यक \nअवसंरचना क े िनमार्ण और आवतीर् å यय क े िलए è वीकृ त िकया गया था। \n***** \n113\n\n \n \n \n \n \n27.06.2019 \n \n \n668.  \n \n  \n \n(  - ; \n(   \n- ; \n(  ; \n( ,  , ;  \n(  -\n ? \n \n \n \n \n,\n, ,\n- -  \n, ,\n- , ,\n,\n, - -\n \n114\n\n \n-\n, - -\n II -\n, - -\n, -\nhttps://www.ugc.ac.in/ugc.notices.aspx?id=2418. ,\nhttps://nherc.in  \n,\n,\n,\n, ,\n \n**** \n  \n115\n\n \n \n116\n\n117\n\n   \n   \n   \n   \n   \n   \n   \n118\n\n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n119\n\n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n120\n\n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n \n   \n   \n   \n   \n121\n\n \n   \n \n \n \n \n \n \n    / / /         \n \n    \n   \n  \n  \n \n  \n \n   \n122\n\n   \n   \n   \n   \n   \n  \n \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n  \n123\n\n \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n   \n      \n \n124\n\n \n \n \n \n \n \n27  \n \n \n \n \n  \n \n; \n, \n;  \n-\n? \n \n \n' '  \n,  \n \n \n \n,  \n***** \n \n125\n\n \n \n \n \n670 \n7  \n \n \n670.  \n \n  \n \n(   \n ; \n(   \n ; \n(  ;  \n( , ? \n \n \n \n \n(  ( : \n,  \n103 , 2019 , \n10 \n \n - , \n \n , , \n \n \n : \n-   \n126\n\n), ) ) \n ,\n \n ) \n, , \n; ,\n \n \n \n \n, , , , \n, \n \n,  \n \n \n***** \n  \n127\n\n671\n27.06.2019\n671\n   \n( ) ( ) \n; \n( )   \n; \n( )  ;\n \n( )   \n? \n \n( ‘ ’)\n( ) ( ) : \n  ( ) \n2000-2001 2017-18 , \n( ) \n( ) –  \n , 2018-19 \n- XII  \n  \n128\n\n2016-17, 2017-18 2018-19 \n. 22500.00 ., 23500.00 .30780.81 \n( ) : / ,\n/ , ( ) \n \n, 2009 \n \n \n( ) 2001 2018-19 , 3.64 \n 3,12,747 , 18,89,689 -\n, 2,40,564 10,63,164 \n  31.03.2019 3.60 \n, 2 ,96,627 , 18 ,17,081 , 2 ,34,409 \n10,22,1